# ── 依赖 ──
node_modules/

# ── 构建产物 ──
# 注意：player-ui.html **要入库**（克隆下来直接能用，不必先构建）
labs/*.html
labs/*.png
labs/*.jpg
*.tmp

# ── 桌面壁纸模式的运行产物 ──
desktop/logs/
desktop/shots/

# ── 跑测试/调试时的临时产物 ──
.cdp-*/
*-check.png
*-strip.png
debug-*.png
shrink-test.png

# ── 自动截图目录 ──
# 这些图带环境状态、容易过期误导人，不入库。
# 需要时现截：node src/tools/shots/verify-live-ui.mjs <路径>
# 想要长期展示的预览图放 docs/preview/（那个目录不在忽略列表里）
docs/shots/
overlay/shots/

# ── 备份 / 归档 ──
_archive/
*.bak
*.orig

# ── 系统 ──
Thumbs.db
desktop.ini
.DS_Store
